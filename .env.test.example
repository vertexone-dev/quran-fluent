# E2E test credentials (Playwright).
#
# Copy this file to `.env.test` and fill in a DEDICATED test account on the
# project's Supabase instance. Never use a real learner's account, and never
# commit `.env.test` (it is gitignored).
#
# The account must already exist AND have its email confirmed — the E2E
# suite signs in with a password grant, it does not complete email
# confirmation for you.

E2E_TEST_EMAIL="e2e-test@example.com"
E2E_TEST_PASSWORD="change-me"

# Same values as .env / .env.example — the test runner talks to Supabase
# directly (outside the app) to seed/verify database state.
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
