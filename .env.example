# QuranRoots — environment variables (example, no secrets)
#
# Values are injected automatically by Lovable Cloud per environment
# (development / preview / production). Copy this file to `.env` only for
# local experiments and never commit real values.

# --- Client-visible (safe to expose, publishable) -------------------------
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
VITE_SUPABASE_PROJECT_ID="<project-ref>"

# --- Server-only (never prefixed with VITE_, never sent to the browser) ---
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
SUPABASE_PROJECT_ID="<project-ref>"

# Managed by the platform, not available to app code or developers:
# SUPABASE_SERVICE_ROLE_KEY  (privileged; server runtime only -- now used by
#   src/lib/billing/supabaseAdmin.ts, the only application code path that
#   reads it, for the webhook handler's writes to billing_customers/
#   billing_subscriptions/billing_webhook_events; see PAYMENT-ARCHITECTURE.md)

# --- Payment foundation (Stripe, test mode only) ---------------------------
# Names only, test-mode placeholders -- see PAYMENT-ARCHITECTURE.md §17.
# Never enter, request, print, commit, or push real (live or test) values.
# Server-only, never prefixed with VITE_, never sent to the browser:
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"
STRIPE_PRICE_ID_MONTHLY="price_xxx_monthly"
STRIPE_PRICE_ID_ANNUAL="price_xxx_annual"
# Server-controlled base URL for Checkout/Portal return redirects -- never
# derived from a request's own Host header (src/lib/billing/env.ts):
APP_BASE_URL="https://quranroots.vertexone.workers.dev"

# Server-only kill switch (never prefixed with VITE_, never sent to the
# browser): the actual authorization check POST /api/billing/checkout
# enforces before ever creating a real Stripe Checkout Session -- see
# src/lib/billing/serverCheckoutFlag.ts. Defaults to disabled when unset,
# empty, or any value other than the exact string "true" -- fails closed.
# This is NOT set by the GitHub Actions deploy workflow (that workflow only
# ever supplies VITE_-prefixed values at build time); it must be configured
# directly as a Cloudflare Worker environment variable on the `quranroots`
# Worker (Cloudflare dashboard -> Workers & Pages -> quranroots -> Settings
# -> Variables, or `wrangler vars put`/`wrangler secret put`), the same way
# STRIPE_SECRET_KEY above already is -- see DEPLOYMENT.md §5.
BILLING_CHECKOUT_ENABLED="false"

# Client-safe (safe to expose): gates every "start checkout" button in the
# UI. Defaults to disabled when unset -- see src/lib/billing/checkoutFlag.ts.
# In production this is set via a GitHub Actions *environment variable*
# (never a secret) on the `production` environment -- see
# PAYMENT-ARCHITECTURE.md §19.1 for the full controlled-rollout sequence.
# Independent of BILLING_CHECKOUT_ENABLED above -- this one only ever hides
# or shows client UI buttons; it has never authorized a server-side
# Checkout Session and still doesn't after this PR. Both must be "true" for
# a real end-to-end checkout to be reachable by a user.
VITE_BILLING_CHECKOUT_ENABLED="false"
