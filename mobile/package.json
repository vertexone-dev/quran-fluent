{
  "name": "quranroots-mobile-feasibility",
  "private": true,
  "version": "0.1.0-feasibility",
  "description": "Phase 0 offline-first mobile feasibility prototype -- a separate, locally bundled client build, kept fully independent from the existing Cloudflare/Nitro production app. Not wired into any production build or deploy pipeline.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "export-content": "node scripts/export-content-db.mjs",
    "test": "cd .. && npx vitest run --config mobile/vitest.config.ts",
    "test:e2e": "cd .. && npx playwright test --config mobile/playwright.config.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sql.js": "^1.15.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.2.0"
  }
}
