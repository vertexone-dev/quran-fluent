<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+): Cloud Backup and Device-to-Device Transfer.
  QR-RELEASE-002A backup policy (see mobile/docs/ANDROID-BACKUP-POLICY.md).

  The app's user data lives in WebView localStorage (one LevelDB directory): bookmarks,
  reading position, preferences AND the user's private reflections (their own written
  words, qr.reflections). LevelDB cannot be split by key, so the directory is all-or-nothing.

  - cloud-backup: NOTHING is uploaded. Private reflections must never leave the device
    for a cloud service. Every backup domain is excluded explicitly because an element
    with no <include> would otherwise back up everything.
  - device-transfer: the localStorage directory IS copied, so a user moving to a new
    phone by cable or direct transfer keeps bookmarks, position, preferences and
    reflections. Both devices are in the user's hands.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="app_webview/Default/Local Storage/" />
    </device-transfer>
</data-extraction-rules>
