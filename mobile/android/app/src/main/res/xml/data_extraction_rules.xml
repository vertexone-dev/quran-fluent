<?xml version="1.0" encoding="utf-8"?>
<!--
  Governs Cloud Backup and Device-to-Device Transfer on Android 12 (API
  31) and higher, since this app targets API 36. See backup_rules.xml's
  own comment for the full rationale (same rules, same reasoning, just
  the newer XML schema). Both files are required since this app's
  minSdk (24) spans both eras.

  disableIfNoEncryptionCapabilities="true" on <cloud-backup> skips the
  cloud upload entirely on a device that can't encrypt it (no screen
  lock), rather than uploading bookmarks/preferences unencrypted.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="root" path="app_webview/Default/Local Storage/" />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="app_webview/Default/Local Storage/" />
    </device-transfer>
</data-extraction-rules>
