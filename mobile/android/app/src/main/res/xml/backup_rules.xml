<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 and lower (API 30-): Auto Backup. QR-RELEASE-002A backup policy (see
  mobile/docs/ANDROID-BACKUP-POLICY.md). This schema cannot tell cloud backup from
  device transfer, and the user's private reflections share one LevelDB directory with
  their bookmarks, so on these versions NOTHING is backed up. Android 12+ devices use
  data_extraction_rules.xml, which keeps device-to-device transfer.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
